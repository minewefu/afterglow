<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>afterglow-cli</AssemblyName>
    <RootNamespace>Afterglow.Cli</RootNamespace>
    <Description>Command-line companion for Afterglow: self-test, monitoring, and scriptable tuning.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Afterglow.Core\Afterglow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ThirdParty\PresentMon\**"
          Link="ThirdParty\PresentMon\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
