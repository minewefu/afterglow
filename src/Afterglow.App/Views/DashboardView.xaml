<UserControl x:Class="Afterglow.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Afterglow.App.Controls"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding ThrottleMarginText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ThrottleChips}" HorizontalAlignment="Right"
                              VerticalAlignment="Top" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}"
                                    CornerRadius="4" Padding="8,3" Margin="6,0,0,0"
                                    ToolTip="{Binding Explanation}">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Hero tiles (click or Enter to expand the 10-minute graph). The grid's -12 right
                 margin cancels the last column's gap so the gaps are even. -->
            <UniformGrid Columns="4" Margin="0,20,-12,0">
                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="clock" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="Core clock: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="Core clock" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding CoreClockText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="MHz" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemClockText}" Style="{StaticResource MetricSub}" />
                        <controls:SparkGraph Values="{Binding CoreClockSeries}" Stroke="{StaticResource SeriesClock}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="temp" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="Temperature: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="Temperature" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TempText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="°C" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HotSpotText}" Style="{StaticResource MetricSub}" />
                            <TextBlock Text="{Binding MemJunctionText}" Style="{StaticResource MetricSub}" Margin="10,0,0,0" />
                        </StackPanel>
                        <controls:SparkGraph Values="{Binding TempSeries}" Stroke="{StaticResource SeriesTemp}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="power" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes"
                        AutomationProperties.Name="{Binding PowerTitle, StringFormat='{}{0}: show the last 10 minutes'}">
                    <StackPanel>
                        <TextBlock Text="{Binding PowerTitle}" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PowerText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="W" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PowerLimitText}" Style="{StaticResource MetricSub}" />
                        <controls:SparkGraph Values="{Binding PowerSeries}" Stroke="{StaticResource SeriesPower}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="util" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="GPU load: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="GPU load" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding UtilText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PerfStateText}" Style="{StaticResource MetricSub}" />
                        <controls:SparkGraph Values="{Binding UtilSeries}" Stroke="{StaticResource SeriesUtil}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180"
                                             FixedMin="0" FixedMax="100" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="vram" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="Video memory: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="VRAM" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding VramText}" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                        <ProgressBar Value="{Binding VramFraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,6"
                                     Foreground="{StaticResource SeriesVram}" />
                        <controls:SparkGraph Values="{Binding VramSeries}" Stroke="{StaticResource SeriesVram}"
                                             Height="34" Margin="0,6,0,0" ShowScale="False" Capacity="180" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="fan" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="Fans: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="Fans" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding FanText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FanRpmText}" Style="{StaticResource MetricSub}" />
                        <controls:SparkGraph Values="{Binding FanSeries}" Stroke="{StaticResource SeriesFan}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180"
                                             FixedMin="0" FixedMax="100" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="voltage" Click="OnTileClick"
                        ToolTip="Show the last 10 minutes" AutomationProperties.Name="Core voltage: show the last 10 minutes">
                    <StackPanel>
                        <TextBlock Text="Core voltage" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding VoltageText}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="mV" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EnergyText}" Style="{StaticResource MetricSub}" />
                        <controls:SparkGraph Values="{Binding VoltageSeries}" Stroke="{StaticResource SeriesVoltage}"
                                             Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="180" />
                    </StackPanel>
                </Button>

                <!-- FPS: live while a game is presenting; otherwise an empty state that leads to
                     the FPS page (the click navigates there instead of expanding nothing). -->
                <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Tag="fps" Click="OnTileClick"
                        ToolTip="Show the frametimes" AutomationProperties.Name="Frames per second">
                    <Grid>
                        <StackPanel Visibility="{Binding HasFps, Converter={x:Static views:Converters.BoolToVisibility}}">
                            <TextBlock Text="FPS" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource SeriesFps}" />
                                <TextBlock Text="{Binding FpsAppText}" Style="{StaticResource MetricUnit}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            </StackPanel>
                            <TextBlock Text="{Binding FpsLowsText}" Style="{StaticResource MetricSub}" />
                            <controls:SparkGraph Values="{Binding FrametimeSeries}" Stroke="{StaticResource SeriesFps}"
                                                 Height="34" Margin="0,10,0,0" ShowScale="False" Capacity="360" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasFps, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                            <TextBlock Text="FPS" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="—" Style="{StaticResource MetricValue}" Foreground="{StaticResource TextFaint}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="No game detected" Style="{StaticResource MetricSub}" />
                            <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource Accent}">
                                <Run Text="Open FPS &amp; Frametimes" /><Run Text=" &#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Expanded tile: one full-width hoverable graph for the clicked tile -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,0"
                    Visibility="{Binding IsExpanded, Converter={x:Static views:Converters.BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExpandedTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding ExpandedLabel, StringFormat='   ● {0}'}" FontSize="12"
                                       Foreground="{Binding ExpandedStroke}"
                                       Visibility="{Binding HasExpandedSecondSeries, Converter={x:Static views:Converters.BoolToVisibility}}" />
                            <TextBlock Text="{Binding ExpandedLabel2, StringFormat='   ● {0}'}" FontSize="12"
                                       Foreground="{Binding ExpandedStroke2}"
                                       Visibility="{Binding HasExpandedSecondSeries, Converter={x:Static views:Converters.BoolToVisibility}}" />
                        </StackPanel>
                        <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                                Command="{Binding CloseExpandedCommand}" AutomationProperties.Name="Close the expanded graph">
                            <TextBlock><Run Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" /><Run Text="  Close" /></TextBlock>
                        </Button>
                    </Grid>
                    <controls:SparkGraph Values="{Binding ExpandedSeries}" Values2="{Binding ExpandedSeries2}"
                                         Times="{Binding ExpandedTimes}"
                                         Stroke="{Binding ExpandedStroke}" Stroke2="{Binding ExpandedStroke2}"
                                         Unit="{Binding ExpandedUnit}"
                                         Label="{Binding ExpandedLabel}" Label2="{Binding ExpandedLabel2}"
                                         FixedMin="{Binding ExpandedFixedMin}" FixedMax="{Binding ExpandedFixedMax}"
                                         Capacity="{Binding ExpandedCapacity}" HoverEnabled="True"
                                         Height="260" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Large graphs (hidden while a tile is expanded) -->
            <Grid Visibility="{Binding IsExpanded, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="12" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Core clock · last 10 min" Style="{StaticResource CardTitle}" />
                        <controls:SparkGraph Values="{Binding CoreClockSeries}" Stroke="{StaticResource SeriesClock}"
                                             Times="{Binding SeriesTimes}" HoverEnabled="True" Unit="MHz"
                                             Height="140" Margin="0,12,0,0" Capacity="600" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Temperatures · last 10 min" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="   ● GPU" FontSize="12" Foreground="{StaticResource SeriesTemp}" />
                            <TextBlock Text="{Binding MemSeriesLabel, StringFormat='   ● {0}'}" FontSize="12" Foreground="{StaticResource SeriesVram}" />
                        </StackPanel>
                        <controls:SparkGraph Values="{Binding TempSeries}" Values2="{Binding MemJunctionSeries}"
                                             Stroke="{StaticResource SeriesTemp}" Stroke2="{StaticResource SeriesVram}"
                                             Times="{Binding SeriesTimes}" HoverEnabled="True" Unit="°C"
                                             Label="GPU" Label2="mem"
                                             FixedMin="20" FixedMax="100" Capacity="600"
                                             Height="140" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="{Binding PowerTitle, StringFormat='{}{0} · last 10 min'}" Style="{StaticResource CardTitle}" />
                        <controls:SparkGraph Values="{Binding PowerSeries}" Stroke="{StaticResource SeriesPower}"
                                             Times="{Binding SeriesTimes}" HoverEnabled="True" Unit="W"
                                             Height="140" Margin="0,12,0,0" Capacity="600" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="GPU load · last 10 min" Style="{StaticResource CardTitle}" />
                        <controls:SparkGraph Values="{Binding UtilSeries}" Stroke="{StaticResource SeriesUtil}"
                                             Times="{Binding SeriesTimes}" HoverEnabled="True" Unit="%"
                                             Height="140" Margin="0,12,0,0" FixedMin="0" FixedMax="100" Capacity="600" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
