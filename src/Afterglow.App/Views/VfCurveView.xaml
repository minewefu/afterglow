<UserControl x:Class="Afterglow.App.Views.VfCurveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Afterglow.App.Controls"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Text="V/F Curve" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="How your GPU really trades voltage for clock speed, measured live, and an undervolt computed from it in one click." />

                <ContentControl Style="{StaticResource WarnBanner}" Content="{Binding GateText}" Margin="0,16,0,0"
                                Visibility="{Binding CanApply, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Measured curve" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource SectionDescription}"
                                           Text="Click or drag on the chart to pick a target. Blue: the clock reached at each voltage. Shading: time spent there. Orange: right now." />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SampleText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <controls:VfCurveChart x:Name="Chart" Height="320" Margin="0,12,0,0"
                                               Curve="{Binding Curve}" PeakSamples="{Binding PeakSamples}"
                                               DriverCurve="{Binding DriverCurve}"
                                               LiveVoltage="{Binding LiveVoltage}" LiveClock="{Binding LiveClock}"
                                               TargetVoltage="{Binding TargetVoltage}" TargetClock="{Binding TargetClock}" />
                        <TextBlock Text="Gold dashed: the driver's stored per-point table, with your offsets applied."
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Visibility="{Binding SupportsVfPoints, Converter={x:Static views:Converters.BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Undervolt from this curve" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding PlanText}" Style="{StaticResource StatusText}" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Apply undervolt" MinWidth="150" Margin="0,0,8,0"
                                    Command="{Binding ApplyPlanCommand}"
                                    IsEnabled="{Binding HasPlan}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding ToggleProbeCommand}" IsEnabled="{Binding CanApply}"
                                    ToolTip="Locks the core clock at each step under a compute load and records the voltage the driver picks, mapping the whole curve in a minute or two, then puts your previous settings back.">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InheritingText}">
                                            <Setter Property="Text" Value="Probe full curve (~1 min)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProbeRunning}" Value="True">
                                                    <Setter Property="Text" Value="Cancel probe" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Content="Clear measured curve" FontSize="14"
                                    MinHeight="32" Command="{Binding ResetCurveCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ProbeStatusText}" Style="{StaticResource StatusText}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding ApplyResultText}" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastApplyFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Per-point curve editor: shown on any GPU whose driver answered the live table probe
                     (SupportsVfPoints) - never gated by generation; verified on RTX 50 (F-51) -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding SupportsVfPoints, Converter={x:Static views:Converters.BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Per-point curve editor" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding VfPointsNote}" Style="{StaticResource SectionDescription}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Point" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="0" Maximum="{Binding VfpPointMax}"
                                    Value="{Binding VfpPointSlider}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="12,0,20,0" AutomationProperties.Name="V/F point" />
                            <TextBlock Grid.Column="2" Text="{Binding VfpPointText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Offset this point" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBox Text="{Binding VfpOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                         TextAlignment="Center" AutomationProperties.Name="Point offset, megahertz" />
                                <TextBlock Text="MHz" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,16,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Apply to point"
                                        Command="{Binding ApplyVfPointOffsetCommand}" IsEnabled="{Binding CanApply}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" VerticalAlignment="Center">
                                <TextBlock Text="Flatten from this point" Style="{StaticResource FieldLabel}"
                                           ToolTip="The classic curve undervolt: raise the selected point to the target clock, cap every higher-voltage point to the same clock, and bring any lower-voltage point that stock runs faster than the target down to it, so no point on the curve asks for more than the target." />
                                <TextBlock Text="The classic curve undervolt" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBox Text="{Binding VfpTargetClockText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                         TextAlignment="Center" AutomationProperties.Name="Flatten target clock, megahertz" />
                                <TextBlock Text="MHz" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,16,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Flatten (undervolt)"
                                        Command="{Binding ApplyVfFlattenCommand}" IsEnabled="{Binding CanApply}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding VfpStatusText}" Style="{StaticResource StatusText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Clear all point offsets"
                                    FontSize="14" MinHeight="32" Command="{Binding ClearVfPointsCommand}"
                                    IsEnabled="{Binding CanApply}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding MethodNote}" Style="{StaticResource Footnote}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
