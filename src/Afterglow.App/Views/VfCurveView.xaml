<UserControl x:Class="Afterglow.App.Views.VfCurveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Afterglow.App.Controls"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24" MaxWidth="960" HorizontalAlignment="Left">

            <TextBlock Text="V/F Curve" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Your GPU's real voltage/frequency behavior, measured live — and a one-click undervolt computed from it." />

            <Border Background="#33E8B33C" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                    Visibility="{Binding CanApply, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                <TextBlock Text="{Binding GateText}" Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Measured curve" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Text="Click or drag on the chart to pick a target point. Blue = clock reached at each voltage; shading = time spent there; orange = right now."
                                       FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding SampleText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <controls:VfCurveChart x:Name="Chart" Height="300" Margin="0,10,0,0"
                                           Curve="{Binding Curve}" PeakSamples="{Binding PeakSamples}"
                                           DriverCurve="{Binding DriverCurve}"
                                           LiveVoltage="{Binding LiveVoltage}" LiveClock="{Binding LiveClock}"
                                           TargetVoltage="{Binding TargetVoltage}" TargetClock="{Binding TargetClock}" />
                    <TextBlock Text="Gold dashed = the driver's stored per-point table (with your offsets applied)."
                               FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0"
                               Visibility="{Binding SupportsVfPoints, Converter={x:Static views:Converters.BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Undervolt from this curve" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{Binding PlanText}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply undervolt" MinWidth="150"
                                Command="{Binding ApplyPlanCommand}"
                                IsEnabled="{Binding HasPlan}" />
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Command="{Binding ToggleProbeCommand}" IsEnabled="{Binding CanApply}"
                                ToolTip="Locks the core clock at each step under a compute load and records the voltage the driver selects — mapping the whole curve in about a minute, then restoring your previous state.">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Probe full curve (~1 min)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProbeRunning}" Value="True">
                                                <Setter Property="Text" Value="Cancel probe" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Clear measured curve" Margin="10,0,0,0"
                                Command="{Binding ResetCurveCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProbeStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ApplyResultText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Good}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastApplyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Per-point curve editor: only on GPUs whose driver exposes the table (20/30/40 series) -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding SupportsVfPoints, Converter={x:Static views:Converters.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Per-point curve editor" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{Binding VfPointsNote}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Style="{StaticResource TuneSlider}" Minimum="0" Maximum="{Binding VfpPointMax}"
                                Value="{Binding VfpPointSlider}" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="1" Text="{Binding VfpPointText}" FontSize="12.5"
                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Point offset" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBox Text="{Binding VfpOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                 FontSize="12.5" Margin="8,0,0,6" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="MHz" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="6,0,0,6" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply to point" Margin="10,0,0,6"
                                VerticalAlignment="Center" Command="{Binding ApplyVfPointOffsetCommand}"
                                IsEnabled="{Binding CanApply}" />
                        <Rectangle Width="1" Height="24" Fill="{StaticResource Stroke}" Margin="16,0,16,6" />
                        <TextBlock Text="Flatten at this point to" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,0,6"
                                   ToolTip="The classic curve undervolt: raise the selected point to the target clock and cap every higher-voltage point to the same clock, so the GPU runs the target clock at this voltage and never boosts past it." />
                        <TextBox Text="{Binding VfpTargetClockText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                 FontSize="12.5" Margin="8,0,0,6" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="MHz" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="6,0,0,6" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Flatten (undervolt)" Margin="10,0,0,6"
                                VerticalAlignment="Center" Command="{Binding ApplyVfFlattenCommand}"
                                IsEnabled="{Binding CanApply}" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear all point offsets" Margin="16,0,0,6"
                                VerticalAlignment="Center" Command="{Binding ClearVfPointsCommand}"
                                IsEnabled="{Binding CanApply}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding VfpStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MethodNote}" FontSize="11" Foreground="{StaticResource TextFaint}"
                       TextWrapping="Wrap" Margin="2,10,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
