<UserControl x:Class="Afterglow.App.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Afterglow.App.Views"
             xmlns:controls="clr-namespace:Afterglow.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Text="Stability" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="A burn test that checks every result bit for bit, a VRAM test, and a guided stepper that finds your stable overclock: an open alternative to closed OC scanners." />

                <!-- Burn test -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Burn test" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Runs a fixed compute workload and checks every answer. A single wrong bit means the GPU is miscalculating at these clocks. Driver resets (TDR) are caught and reported too." />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{Binding PatternIndex}" Margin="12,0,0,0"
                                      HorizontalAlignment="Left" MinWidth="360" AutomationProperties.Name="Burn pattern"
                                      IsEnabled="{Binding StressRunning, Converter={x:Static views:Converters.InverseBool}}">
                                <ComboBoxItem Content="Sustained burn: full load" />
                                <ComboBoxItem Content="Transition cycling: load/idle clock switches" />
                                <ComboBoxItem Content="Boost excursions: bursty, desktop-style load" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PatternDescription}"
                                       Style="{StaticResource FieldHint}" Margin="12,6,0,0" />

                            <TextBlock Grid.Row="3" Text="Load intensity" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="512" Maximum="8192"
                                    Margin="12,0,20,0" AutomationProperties.Name="Burn intensity, iterations per dispatch"
                                    Value="{Binding Intensity}" TickFrequency="256" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding StressRunning, Converter={x:Static views:Converters.InverseBool}}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding IntensityLabel}" Style="{StaticResource ValueLabel}"
                                       FontWeight="Normal" Foreground="{StaticResource TextMuted}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" MinWidth="130" VerticalAlignment="Center"
                                    Command="{Binding ToggleStressCommand}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InheritingText}">
                                            <Setter Property="Text" Value="Start burn" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StressRunning}" Value="True">
                                                    <Setter Property="Text" Value="Stop burn" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding StressElapsedText}" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StressRateText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Live sensor line while it runs (and the last reading after). -->
                        <Border Style="{StaticResource InsetPanel}" Margin="0,16,0,0" Padding="12,8"
                                Visibility="{Binding LiveStatsText, Converter={x:Static views:Converters.NonEmptyToVisibility}}">
                            <TextBlock Text="{Binding LiveStatsText}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Border>

                        <TextBlock Text="{Binding StressStatusText}" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StressFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- VRAM test -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="VRAM test" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Fills as much video memory as Windows safely allows (within the DXGI budget, so nothing gets paged out) and checks every value on the GPU. Any error means the memory offset is unstable; this catches what the burn test can't." />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" MinWidth="150" VerticalAlignment="Center"
                                    Command="{Binding ToggleVramCommand}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InheritingText}">
                                            <Setter Property="Text" Value="Start VRAM test" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VramRunning}" Value="True">
                                                    <Setter Property="Text" Value="Stop VRAM test" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding VramStatsText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="{Binding VramStatusText}" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VramFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Stepper -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Find my stable overclock" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Raises the core offset step by step and burn-tests each step. At the first failure it backs off and runs a longer confirmation, then leaves the confirmed stable offset applied." />

                        <ContentControl Style="{StaticResource WarnBanner}" Content="{Binding StepGateText}" Margin="0,12,0,0"
                                        Visibility="{Binding CanStep, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Step size" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="10" Maximum="60" Value="{Binding StepMHz}"
                                    Margin="12,0,20,0" AutomationProperties.Name="Stepper step size, megahertz"
                                    TickFrequency="5" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="2" Text="{Binding StepMHz, StringFormat='+{0:F0} MHz'}" Style="{StaticResource ValueLabel}" />

                            <TextBlock Grid.Row="2" Text="Time per step" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="30" Maximum="300"
                                    Value="{Binding SecondsPerStep}" Margin="12,0,20,0" AutomationProperties.Name="Seconds per step"
                                    TickFrequency="15" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SecondsPerStep, StringFormat='{}{0:F0} s'}"
                                       Style="{StaticResource ValueLabel}" />

                            <TextBlock Grid.Row="4" Text="Highest offset to try" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="50" Maximum="600"
                                    Value="{Binding MaxOffset}" Margin="12,0,20,0" AutomationProperties.Name="Maximum offset to try, megahertz"
                                    TickFrequency="25" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding MaxOffset, StringFormat='+{0:F0} MHz'}"
                                       Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" MinWidth="150" VerticalAlignment="Center"
                                    Command="{Binding ToggleStepperCommand}" IsEnabled="{Binding CanStep}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InheritingText}">
                                            <Setter Property="Text" Value="Start stepper" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepperRunning}" Value="True">
                                                    <Setter Property="Text" Value="Cancel stepper" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding StepperPhaseText}" Style="{StaticResource StatusText}"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>

                        <!-- Progress and log exist once a run has something to show. The log is the
                             whole run's, scrollable and selectable, and stays after the run (#7). -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding StepperLog.Count, Converter={x:Static views:Converters.NonZeroToVisibility}}">
                            <ProgressBar Value="{Binding StepperProgress, Mode=OneWay}" Maximum="1" />
                            <Grid Margin="0,8,0,4">
                                <TextBlock Text="Log" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SubtleButton}" Content="Copy log" HorizontalAlignment="Right"
                                        Command="{Binding CopyStepperLogCommand}"
                                        AutomationProperties.Name="Copy the stepper log" />
                            </Grid>
                            <controls:LogView Lines="{Binding StepperLog}" AutomationProperties.Name="Stepper log" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Crash forensics -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Crash forensics" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Copy report"
                                    Command="{Binding CopyCrashReportCommand}"
                                    Visibility="{Binding HasCrashReport, Converter={x:Static views:Converters.BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="The flight recorder keeps the last few minutes of sensor data on disk. If a session ends in a hard crash, its final seconds are matched against the Windows event log and explained here in plain language." />
                        <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding CrashReportText}" Style="{StaticResource LogText}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
