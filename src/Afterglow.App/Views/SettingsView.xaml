<UserControl x:Class="Afterglow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <!-- Laid out like Windows 11 Settings: grouped cards, one setting per row, the label and its
         explanation on the left, the control on the right. -->
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}" />
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="How Afterglow starts, what it records, and what it does on its own." />

                <!-- ============ General ============ -->
                <TextBlock Text="General" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Starts Afterglow at sign-in through Task Scheduler. On an administrator account it runs elevated, with no UAC prompt."
                                           Style="{StaticResource RowHint}" />
                                <TextBlock Text="{Binding StartWithWindowsAccountNote}" Style="{StaticResource WarnNote}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding StartWithWindowsNote}" Style="{StaticResource WarnNote}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start minimized to the tray" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding StartMinimizedToTray}" AutomationProperties.Name="Start minimized to the tray" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Close button minimizes to the tray" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding CloseToTray}" AutomationProperties.Name="Close button minimizes to the tray" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Reset tuning after a driver crash" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="When Windows reports a GPU driver reset (TDR), go back to driver defaults."
                                           Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding ResetOnDriverCrash}" AutomationProperties.Name="Reset tuning after a driver crash" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Apply a profile at startup" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Only profiles marked stable are applied, so an untested overclock never loads itself at boot."
                                           Style="{StaticResource RowHint}" />
                                <TextBlock Text="{Binding StartupProfileNote}" Style="{StaticResource WarnNote}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StartupProfileOptions}" SelectedItem="{Binding SelectedStartupProfile}"
                                      MinWidth="200" MaxWidth="320" VerticalAlignment="Center" AutomationProperties.Name="Profile to apply at startup" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="Work everywhere, even while a game has focus. A shortcut that would type a character on one of your keyboard layouts is never used: AltGr is Ctrl+Alt to Windows, so on a Spanish keyboard Ctrl+Alt+2 is @." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding HotkeysEnabled}" AutomationProperties.Name="Keyboard shortcuts" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HotkeyRows}" Focusable="False" IsEnabled="{Binding HotkeysEnabled}"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutButtons" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource StatusText}" FontSize="12" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource StatusText}" FontSize="12" />
                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource WarnNote}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Visibility="{Binding IsRecording, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Keycap}">
                                                        <TextBlock Text="{Binding}" FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="1" Text="None" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="0,0,16,0"
                                                   Visibility="{Binding HasNoKeys, Converter={x:Static views:Converters.BoolToVisibility}}" />
                                        <TextBlock Grid.Column="1" Text="Press the new shortcut · Esc cancels" FontSize="12"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Visibility="{Binding IsRecording, Converter={x:Static views:Converters.BoolToVisibility}}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleButton}" Content="{Binding ChangeLabel}" MinWidth="72"
                                                    Command="{Binding ChangeCommand}" LostKeyboardFocus="OnRecordingButtonLostFocus"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Change shortcut: {0}'}" />
                                            <Button Style="{StaticResource SubtleButton}" Content="Remove" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Remove shortcut: {0}'}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" Content="Restore default shortcuts" HorizontalAlignment="Right"
                                Margin="0,6,0,12" Command="{Binding RestoreDefaultShortcutsCommand}" />
                    </StackPanel>
                </Border>

                <!-- ============ Monitoring ============ -->
                <TextBlock Text="Monitoring" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sensor polling interval" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="How often every sensor is read" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="100" Maximum="5000" Margin="12,0,20,0"
                                    Value="{Binding PollingIntervalMs}" TickFrequency="100" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Sensor polling interval, milliseconds" />
                            <TextBlock Grid.Column="2" Text="{Binding PollingLabel}" Style="{StaticResource ValueLabel}" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Log sensors to CSV" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Every sensor, every poll, HWiNFO-style, with automatic file rotation."
                                           Style="{StaticResource RowHint}" />
                                <TextBlock Text="{Binding CsvStatusText}" Style="{StaticResource StatusText}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding CsvLoggingEnabled}" AutomationProperties.Name="Log sensors to CSV" />
                        </Grid>
                        <Separator />
                        <StackPanel Margin="0,12">
                            <TextBlock Text="Temperature alerts" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="A notification when a temperature crosses its threshold. Slide all the way left to turn one off."
                                       Style="{StaticResource RowHint}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="GPU core" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextMuted}" />
                                <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="49" Maximum="95" Margin="12,0,20,0"
                                        Value="{Binding AlertGpuTemp}" TickFrequency="1" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="GPU core temperature alert, degrees Celsius" />
                                <TextBlock Grid.Column="2" Text="{Binding AlertGpuLabel}" Style="{StaticResource ValueLabel}" />
                                <TextBlock Grid.Row="1" Text="Memory junction" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextMuted}" />
                                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="49" Maximum="105" Margin="12,0,20,0"
                                        Value="{Binding AlertMemTemp}" TickFrequency="1" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Memory junction temperature alert, degrees Celsius" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AlertMemLabel}" Style="{StaticResource ValueLabel}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Automation ============ -->
                <TextBlock Text="Automation" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Rules" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="When a reading stays at or above a threshold for long enough, act: switch to a profile, pin the fans, or reset to defaults. A rule re-arms after 5 minutes; every firing shows a notification and is logged." />

                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="When" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <ComboBox SelectedIndex="{Binding NewAutoMetricIndex}" MinWidth="170" Margin="0,0,8,6"
                                      VerticalAlignment="Center" AutomationProperties.Name="Reading">
                                <ComboBoxItem Content="GPU temp (°C)" />
                                <ComboBoxItem Content="Mem junction (°C)" />
                                <ComboBoxItem Content="Board power (W)" />
                            </ComboBox>
                            <TextBlock Text="≥" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Text="{Binding NewAutoThreshold, UpdateSourceTrigger=PropertyChanged}" Width="64"
                                     Margin="0,0,8,6" TextAlignment="Center" VerticalAlignment="Center"
                                     AutomationProperties.Name="Threshold" />
                            <TextBlock Text="for" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Text="{Binding NewAutoSeconds, UpdateSourceTrigger=PropertyChanged}" Width="56"
                                     Margin="0,0,6,6" TextAlignment="Center" VerticalAlignment="Center"
                                     AutomationProperties.Name="Seconds" />
                            <TextBlock Text="s, then" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <ComboBox SelectedIndex="{Binding NewAutoActionIndex}" MinWidth="170" Margin="0,0,8,6"
                                      VerticalAlignment="Center" AutomationProperties.Name="Action">
                                <ComboBoxItem Content="Set fans fixed %" />
                                <ComboBoxItem Content="Apply profile" />
                                <ComboBoxItem Content="Reset to defaults" />
                            </ComboBox>
                            <TextBox Text="{Binding NewAutoFanPct, UpdateSourceTrigger=PropertyChanged}" Width="56"
                                     Margin="0,0,8,6" TextAlignment="Center" VerticalAlignment="Center"
                                     ToolTip="Fan duty %" AutomationProperties.Name="Fan duty, percent"
                                     Visibility="{Binding NewAutoActionIsFans, Converter={x:Static views:Converters.BoolToVisibility}}" />
                            <ComboBox ItemsSource="{Binding StartupProfileOptions}" SelectedItem="{Binding NewAutoProfile}"
                                      MinWidth="170" Margin="0,0,8,6" VerticalAlignment="Center" ToolTip="Profile to apply"
                                      AutomationProperties.Name="Profile to apply"
                                      Visibility="{Binding NewAutoActionIsProfile, Converter={x:Static views:Converters.BoolToVisibility}}" />
                            <Button Style="{StaticResource GhostButton}" Content="Add rule" Margin="4,0,0,6"
                                    VerticalAlignment="Center" Command="{Binding AddAutomationRuleCommand}" />
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding AutomationRules}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg3}" CornerRadius="4" Padding="12,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" VerticalAlignment="Center">
                                                <Run Text="{Binding Metric, Mode=OneWay}" /><Run Text=" ≥ " /><Run Text="{Binding Threshold, Mode=OneWay, StringFormat=F0}" /><Run Text=" for " /><Run Text="{Binding ForSeconds, Mode=OneWay}" /><Run Text=" s → " /><Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding ActionProfile, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Remove"
                                                    Command="{Binding DataContext.RemoveAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Overlay ============ -->
                <TextBlock Text="Overlay" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowHint}" Margin="0"
                                       Text="Drawn on top of borderless and windowed games, with nothing injected into the game. It can't appear over legacy exclusive fullscreen." />
                            <TextBlock Style="{StaticResource RowHint}" Text="{Binding OverlayShortcutHint}" />
                        </StackPanel>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding OverlayCornerIndex}" MinWidth="170"
                                      AutomationProperties.Name="Overlay position">
                                <ComboBoxItem Content="Top left" />
                                <ComboBoxItem Content="Top right" />
                                <ComboBoxItem Content="Bottom left" />
                                <ComboBoxItem Content="Bottom right" />
                            </ComboBox>
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="0.3" Maximum="1" Margin="12,0,20,0"
                                    Value="{Binding OverlayOpacity}" AutomationProperties.Name="Overlay opacity" />
                            <TextBlock Grid.Column="2" Text="{Binding OverlayOpacity, StringFormat=P0}" Style="{StaticResource ValueLabel}" />
                        </Grid>
                        <Separator />
                        <StackPanel Margin="0,12">
                            <TextBlock Text="Show" Style="{StaticResource RowTitle}" />
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="FPS" IsChecked="{Binding OverlayShowFps}" Margin="0,0,24,8" />
                                <CheckBox Content="Frametime graph" IsChecked="{Binding OverlayShowGraph}" Margin="0,0,24,8" />
                                <CheckBox Content="Temperatures" IsChecked="{Binding OverlayShowTemp}" Margin="0,0,24,8" />
                                <CheckBox Content="Power" IsChecked="{Binding OverlayShowPower}" Margin="0,0,24,8" />
                                <CheckBox Content="Clock" IsChecked="{Binding OverlayShowClock}" Margin="0,0,24,8" />
                                <CheckBox Content="VRAM" IsChecked="{Binding OverlayShowVram}" Margin="0,0,24,8" />
                                <CheckBox Content="Fans" IsChecked="{Binding OverlayShowFan}" Margin="0,0,24,8" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ About ============ -->
                <TextBlock Text="About" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{Binding AboutText}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Data folder" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding DataPathText}" Style="{StaticResource RowHint}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" ToolTip="{Binding DataPathText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Open folder" VerticalAlignment="Center"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                        <Separator />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Check for updates at startup" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="One anonymous request to the GitHub Releases API. Nothing is uploaded."
                                           Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding UpdateCheckEnabled}" AutomationProperties.Name="Check for updates at startup" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource StatusText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Check now"
                                        Command="{Binding CheckForUpdatesNowCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Releases page" Margin="8,0,0,0"
                                        Command="{Binding OpenReleasesPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
