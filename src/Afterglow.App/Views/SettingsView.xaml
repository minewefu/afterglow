<UserControl x:Class="Afterglow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Monitoring" FontWeight="SemiBold" FontSize="13.5" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Polling interval" FontSize="12.5" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="100" Maximum="5000"
                                Value="{Binding PollingIntervalMs}" TickFrequency="100" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PollingLabel}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="CSV sensor logging" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="HWiNFO-style logging of every sensor to a CSV file, with automatic rotation."
                               FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Log to CSV" Margin="0,10,0,0"
                              IsChecked="{Binding CsvLoggingEnabled}" />
                    <TextBlock Text="{Binding CsvStatusText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Apply at startup" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="Automatically apply a saved profile when Afterglow starts. Only profiles you've marked stable actually apply — an untested overclock never loads itself at boot."
                               FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <ComboBox ItemsSource="{Binding StartupProfileOptions}" SelectedItem="{Binding SelectedStartupProfile}"
                              Margin="0,10,0,0" MaxWidth="340" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StartupProfileNote}" FontSize="11.5" Foreground="{StaticResource Warn}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Behavior" FontWeight="SemiBold" FontSize="13.5" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Close button minimizes to tray"
                              IsChecked="{Binding CloseToTray}" Margin="0,12,0,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start minimized to tray"
                              IsChecked="{Binding StartMinimizedToTray}" Margin="0,10,0,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Start with Windows (elevated via Task Scheduler — no UAC prompt at logon)"
                              IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StartWithWindowsNote}" FontSize="11.5" Foreground="{StaticResource Warn}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Auto-reset tuning if a GPU driver crash (TDR) is detected"
                              IsChecked="{Binding ResetOnDriverCrash}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding HotkeysText}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Automation rules -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Automation rules" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="When a metric stays at or above a threshold for the given time, act: switch to a profile, pin the fans, or reset to defaults. Rules re-arm after a 5-minute cooldown; every firing raises a tray notification and is logged."
                               FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox SelectedIndex="{Binding NewAutoMetricIndex}" Width="140">
                            <ComboBoxItem Content="GPU temp (°C)" />
                            <ComboBoxItem Content="Mem junction (°C)" />
                            <ComboBoxItem Content="Board power (W)" />
                        </ComboBox>
                        <TextBlock Text="≥" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Text="{Binding NewAutoThreshold, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                 FontSize="12.5" Margin="6,0,0,0" />
                        <TextBlock Text="for" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Text="{Binding NewAutoSeconds, UpdateSourceTrigger=PropertyChanged}" Width="45"
                                 FontSize="12.5" Margin="6,0,0,0" />
                        <TextBlock Text="s →" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                        <ComboBox SelectedIndex="{Binding NewAutoActionIndex}" Width="140" Margin="8,0,0,0">
                            <ComboBoxItem Content="Set fans fixed %" />
                            <ComboBoxItem Content="Apply profile" />
                            <ComboBoxItem Content="Reset to defaults" />
                        </ComboBox>
                        <TextBox Text="{Binding NewAutoFanPct, UpdateSourceTrigger=PropertyChanged}" Width="45"
                                 FontSize="12.5" Margin="8,0,0,0" ToolTip="Fan duty % (for the fan action)" />
                        <ComboBox ItemsSource="{Binding StartupProfileOptions}" SelectedItem="{Binding NewAutoProfile}"
                                  Width="140" Margin="8,0,0,0" ToolTip="Profile (for the profile action)" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Add" Margin="10,0,0,0"
                                Command="{Binding AddAutomationRuleCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AutomationRules}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg3}" CornerRadius="7" Padding="10,7" Margin="0,3">
                                    <Grid>
                                        <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                            <Run Text="{Binding Metric, Mode=OneWay}" /><Run Text=" ≥ " /><Run Text="{Binding Threshold, Mode=OneWay, StringFormat=F0}" /><Run Text=" for " /><Run Text="{Binding ForSeconds, Mode=OneWay}" /><Run Text=" s → " /><Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding ActionProfile, Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Style="{StaticResource GhostButton}" Content="Remove" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.RemoveAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Overlay" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="Composited on top of borderless/windowed games (no injection, anticheat-friendly). Not visible over legacy exclusive-fullscreen."
                               FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Position" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            <ComboBox SelectedIndex="{Binding OverlayCornerIndex}" Margin="0,6,10,0">
                                <ComboBoxItem Content="Top left" />
                                <ComboBoxItem Content="Top right" />
                                <ComboBoxItem Content="Bottom left" />
                                <ComboBoxItem Content="Bottom right" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                <Run Text="Opacity: " /><Run Text="{Binding OverlayOpacity, StringFormat=P0}" />
                            </TextBlock>
                            <Slider Style="{StaticResource TuneSlider}" Minimum="0.3" Maximum="1"
                                    Value="{Binding OverlayOpacity}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="FPS" IsChecked="{Binding OverlayShowFps}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Frametime graph" IsChecked="{Binding OverlayShowGraph}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Temps" IsChecked="{Binding OverlayShowTemp}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Power" IsChecked="{Binding OverlayShowPower}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Clock" IsChecked="{Binding OverlayShowClock}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="VRAM" IsChecked="{Binding OverlayShowVram}" Margin="0,0,18,8" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Fans" IsChecked="{Binding OverlayShowFan}" Margin="0,0,18,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Temperature alerts" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="Tray notification when a temperature crosses the threshold (slide to the far left to disable)."
                               FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GPU core" FontSize="12.5" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="49" Maximum="95"
                                Value="{Binding AlertGpuTemp}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" Text="{Binding AlertGpuLabel}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory junction" FontSize="12.5" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="49" Maximum="105"
                                Value="{Binding AlertMemTemp}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" Text="{Binding AlertMemLabel}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{Binding AboutText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding DataPathText}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                               Margin="0,6,0,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Open data folder" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" />

                    <Separator Margin="0,12,0,0" Background="{StaticResource Bg3}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="Check for updates at startup (one anonymous request to the GitHub Releases API — nothing is uploaded)"
                              IsChecked="{Binding UpdateCheckEnabled}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Check now"
                                Command="{Binding CheckForUpdatesNowCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Releases page" Margin="8,0,0,0"
                                Command="{Binding OpenReleasesPageCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
