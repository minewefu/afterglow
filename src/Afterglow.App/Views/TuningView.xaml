<UserControl x:Class="Afterglow.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="Tuning" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding PageSubtitle}" />

            <Border Background="#33E8B33C" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                    Visibility="{Binding CanTune, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                <TextBlock Text="{Binding TuneGateText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                           FontSize="12.5" />
            </Border>

            <!-- Core offset -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding ShowCoreOffset, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Core clock offset" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}">
                            <Run Text="{Binding Capabilities.CoreOffsetMinMHz, Mode=OneWay}" /><Run Text=" to +" /><Run Text="{Binding Capabilities.CoreOffsetMaxMHz, Mode=OneWay}" /><Run Text=" MHz" />
                        </TextBlock>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" VerticalAlignment="Center"
                            Minimum="{Binding Capabilities.CoreOffsetMinMHz}" Maximum="{Binding Capabilities.CoreOffsetMaxMHz}"
                            Value="{Binding CoreOffset}" TickFrequency="5" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CanTune}" />
                    <TextBlock Grid.Column="2" Text="{Binding CoreOffsetLabel}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Memory offset -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding ShowMemOffset, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Memory clock offset" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap">
                            <Run Text="{Binding Capabilities.MemOffsetMinMHz, Mode=OneWay}" /><Run Text=" to +" /><Run Text="{Binding Capabilities.MemOffsetMaxMHz, Mode=OneWay}" /><Run Text=" MHz (+500 = +1 Gbps)" />
                        </TextBlock>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" VerticalAlignment="Center"
                            Minimum="{Binding Capabilities.MemOffsetMinMHz}" Maximum="{Binding Capabilities.MemOffsetMaxMHz}"
                            Value="{Binding MemOffset}" TickFrequency="50" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CanTune}" />
                    <TextBlock Grid.Column="2" Text="{Binding MemOffsetLabel}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Power limit -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding ShowPowerLimit, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Power limit" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}">
                            <Run Text="{Binding Capabilities.PowerLimitMinW, Mode=OneWay, StringFormat=F0}" /><Run Text=" – " /><Run Text="{Binding Capabilities.PowerLimitMaxW, Mode=OneWay, StringFormat=F0}" /><Run Text=" W" />
                        </TextBlock>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" VerticalAlignment="Center"
                            Minimum="{Binding Capabilities.PowerLimitMinW}" Maximum="{Binding Capabilities.PowerLimitMaxW}"
                            Value="{Binding PowerLimit}" TickFrequency="5" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CanTune}" />
                    <TextBlock Grid.Column="2" Text="{Binding PowerLimitLabel}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Voltage boost -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding Capabilities.SupportsVoltageBoost, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Voltage boost" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="Extra core voltage headroom (0–100 % of the driver's small unlock range)"
                                   FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" Value="{Binding VoltageBoost}" TickFrequency="5"
                            IsSnapToTickEnabled="True" IsEnabled="{Binding CanTune}" />
                    <TextBlock Grid.Column="2" Text="{Binding VoltageBoostLabel}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Clock lock / undervolt -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding ShowClockLock, Converter={x:Static views:Converters.BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding ClockLockTitle}" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                       Text="{Binding ClockLockDescription}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsChecked="{Binding LockEnabled}" IsEnabled="{Binding CanTune}" />
                    </Grid>
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding LockEnabled, Converter={x:Static views:Converters.BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target max clock" FontSize="12.5" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" VerticalAlignment="Center"
                                Minimum="{Binding LockClockSliderMin}" Maximum="{Binding Capabilities.MaxCoreClockMHz}"
                                Value="{Binding LockClock}" TickFrequency="15" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding CanTune}" />
                        <TextBlock Grid.Column="2" Text="{Binding LockClockLabel}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Undervolt wizard -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding ShowUndervoltWizard, Converter={x:Static views:Converters.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Undervolt wizard" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="One click loads a lock+offset combination — the same efficiency, less heat, near-same performance trade the community does by hand. Deeper cap = bigger power/heat savings. Apply, then verify with the Stability page." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Efficiency  (~2500 MHz)"
                                Command="{Binding UndervoltPresetCommand}" CommandParameter="efficiency"
                                IsEnabled="{Binding CanTune}" />
                        <Button Style="{StaticResource GhostButton}" Content="Balanced  (~2650 MHz)" Margin="8,0,0,0"
                                Command="{Binding UndervoltPresetCommand}" CommandParameter="balanced"
                                IsEnabled="{Binding CanTune}" />
                        <Button Style="{StaticResource GhostButton}" Content="Light  (~2800 MHz)" Margin="8,0,0,0"
                                Command="{Binding UndervoltPresetCommand}" CommandParameter="light"
                                IsEnabled="{Binding CanTune}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding PowerLimitNote}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                       TextWrapping="Wrap" Margin="2,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <!-- Collapse when empty: an empty TextBlock still spends
                                 its margin, which would shift the NVIDIA layout. -->
                            <DataTrigger Binding="{Binding PowerLimitNote}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding TempLimitNote}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                       TextWrapping="Wrap" Margin="2,10,0,0" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Apply" MinWidth="120"
                        Command="{Binding ApplyCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="Reset to defaults" Margin="10,0,0,0"
                        Command="{Binding ResetCommand}" />
            </StackPanel>

            <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="2,10,0,0"
                       Text="Applied values stay active until reboot or driver reset — they are not re-applied at startup by themselves. To make them automatic: save them as a profile, validate it (Stability page), press 'Mark stable' in Profiles, then pick it under Settings → Apply at startup. Fan mode and curve are saved and restored automatically." />

            <TextBlock Text="{Binding ApplyResultText}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"
                       FontFamily="{StaticResource MonoFont}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastApplyFailed}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
