<UserControl x:Class="Afterglow.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <!-- The Apply bar is pinned under the scrolling settings: the page's one action stays in
         view at any window size, next to what it will do (pending changes) and what it did. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                </Grid.ColumnDefinitions>
                <StackPanel>

                    <TextBlock Text="Tuning" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding PageSubtitle}" />

                    <ContentControl Style="{StaticResource WarnBanner}" Content="{Binding TuneGateText}" Margin="0,16,0,0"
                                    Visibility="{Binding CanTune, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />

                    <!-- Clocks and power: one card, one row per knob -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="16,8"
                            Visibility="{Binding ShowClocksCard, Converter={x:Static views:Converters.BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Visibility="{Binding ShowCoreOffset, Converter={x:Static views:Converters.BoolToVisibility}}">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Core clock offset" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource FieldHint}">
                                            <Run Text="{Binding Capabilities.CoreOffsetMinMHz, Mode=OneWay}" /><Run Text=" to +" /><Run Text="{Binding Capabilities.CoreOffsetMaxMHz, Mode=OneWay}" /><Run Text=" MHz" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Margin="12,0,20,0"
                                            AutomationProperties.Name="Core clock offset, megahertz"
                                            Minimum="{Binding Capabilities.CoreOffsetMinMHz}" Maximum="{Binding Capabilities.CoreOffsetMaxMHz}"
                                            Value="{Binding CoreOffset}" TickFrequency="5" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding CanTune}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CoreOffsetLabel}" Style="{StaticResource ValueLabel}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowMemOffset, Converter={x:Static views:Converters.BoolToVisibility}}">
                                <Separator />

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Memory clock offset" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource FieldHint}">
                                            <Run Text="{Binding Capabilities.MemOffsetMinMHz, Mode=OneWay}" /><Run Text=" to +" /><Run Text="{Binding Capabilities.MemOffsetMaxMHz, Mode=OneWay}" /><Run Text=" MHz · +500 = +1 Gbps" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Margin="12,0,20,0"
                                            AutomationProperties.Name="Memory clock offset, megahertz"
                                            Minimum="{Binding Capabilities.MemOffsetMinMHz}" Maximum="{Binding Capabilities.MemOffsetMaxMHz}"
                                            Value="{Binding MemOffset}" TickFrequency="50" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding CanTune}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemOffsetLabel}" Style="{StaticResource ValueLabel}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowPowerLimit, Converter={x:Static views:Converters.BoolToVisibility}}">
                                <Separator />

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Power limit" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource FieldHint}">
                                            <Run Text="{Binding Capabilities.PowerLimitMinW, Mode=OneWay, StringFormat=F0}" /><Run Text=" – " /><Run Text="{Binding Capabilities.PowerLimitMaxW, Mode=OneWay, StringFormat=F0}" /><Run Text=" W" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Margin="12,0,20,0"
                                            AutomationProperties.Name="Power limit, watts"
                                            Minimum="{Binding Capabilities.PowerLimitMinW}" Maximum="{Binding Capabilities.PowerLimitMaxW}"
                                            Value="{Binding PowerLimit}" TickFrequency="5" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding CanTune}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerLimitLabel}" Style="{StaticResource ValueLabel}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Capabilities.SupportsVoltageBoost, Converter={x:Static views:Converters.BoolToVisibility}}">
                                <Separator />
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Voltage boost" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Share of the driver's small extra-voltage range" Style="{StaticResource FieldHint}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Margin="12,0,20,0"
                                            AutomationProperties.Name="Voltage boost, percent"
                                            Minimum="0" Maximum="100" Value="{Binding VoltageBoost}" TickFrequency="5"
                                            IsSnapToTickEnabled="True" IsEnabled="{Binding CanTune}" />
                                    <TextBlock Grid.Column="2" Text="{Binding VoltageBoostLabel}" Style="{StaticResource ValueLabel}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clock lock / undervolt (a frequency clamp on Intel) -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding ShowClockLock, Converter={x:Static views:Converters.BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{Binding ClockLockTitle}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ClockLockDescription}" Style="{StaticResource SectionDescription}" />
                                    <TextBlock Text="{Binding ClockLockNote}" Style="{StaticResource Footnote}" Margin="0,8,0,0"
                                               Visibility="{Binding ClockLockNote, Converter={x:Static views:Converters.NonEmptyToVisibility}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          AutomationProperties.Name="Clock lock"
                                          IsChecked="{Binding LockEnabled}" IsEnabled="{Binding CanTune}" />
                            </Grid>
                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding LockEnabled, Converter={x:Static views:Converters.BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target max clock" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Margin="12,0,20,0"
                                        AutomationProperties.Name="Clock lock target, megahertz"
                                        Minimum="{Binding LockClockSliderMin}" Maximum="{Binding Capabilities.MaxCoreClockMHz}"
                                        Value="{Binding LockClock}" TickFrequency="15" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding CanTune}" />
                                <TextBlock Grid.Column="2" Text="{Binding LockClockLabel}" Style="{StaticResource ValueLabel}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Undervolt presets (they need both the core offset and the lock) -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding ShowUndervoltWizard, Converter={x:Static views:Converters.BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Undervolt wizard" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Loads a lock + offset pair into the controls above: about the same performance for less power and heat. A lower cap saves more. Apply it, then check it on the Stability page." />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                        Command="{Binding UndervoltPresetCommand}" CommandParameter="efficiency"
                                        IsEnabled="{Binding CanTune}">
                                    <TextBlock><Run Text="Efficiency" /><Run Text="  ~2500 MHz" Foreground="{StaticResource TextMuted}" /></TextBlock>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                        Command="{Binding UndervoltPresetCommand}" CommandParameter="balanced"
                                        IsEnabled="{Binding CanTune}">
                                    <TextBlock><Run Text="Balanced" /><Run Text="  ~2650 MHz" Foreground="{StaticResource TextMuted}" /></TextBlock>
                                </Button>
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding UndervoltPresetCommand}" CommandParameter="light"
                                        IsEnabled="{Binding CanTune}">
                                    <TextBlock><Run Text="Light" /><Run Text="  ~2800 MHz" Foreground="{StaticResource TextMuted}" /></TextBlock>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding PowerLimitNote}" Style="{StaticResource Footnote}" Margin="2,12,0,0" />
                    <TextBlock Text="{Binding TempLimitNote}" Style="{StaticResource Footnote}" />
                    <TextBlock Style="{StaticResource Footnote}"
                               Text="Applied values last until a reboot or driver reset. To restore them at startup: save them as a profile, test it on the Stability page, mark it stable on the Profiles page, then pick it under Settings → Apply at startup. The fan mode and curve are saved and restored on their own." />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Apply bar -->
        <Border Grid.Row="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource StrokeSoft}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid HorizontalAlignment="Left" MaxWidth="1000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButton}" Content="Apply" MinWidth="120" VerticalAlignment="Top"
                        Command="{Binding ApplyCommand}" />
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Reset to defaults" Margin="8,0,0,0"
                        VerticalAlignment="Top" Command="{Binding ResetCommand}" />
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="{StaticResource Accent}"
                               Visibility="{Binding HasPendingChanges, Converter={x:Static views:Converters.BoolToVisibility}}">
                        <Run Text="●" FontSize="10" /><Run Text=" Unapplied changes" />
                    </TextBlock>
                    <TextBlock Text="{Binding ApplyResultText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastApplyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
