<UserControl x:Class="Afterglow.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Afterglow.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Named sets of tuning and fan settings, saved as plain JSON files you can read, back up and share." />

                <!-- Save -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Save the current settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Stores the values on the Tuning page and the fan mode from the Fans page." />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     views:Hint.Placeholder="Profile name, e.g. Quiet 2700 MHz"
                                     AutomationProperties.Name="Profile name" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save profile"
                                    Command="{Binding SaveCurrentCommand}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- List -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Saved profiles" Style="{StaticResource SectionTitle}" />

                        <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0"
                                Visibility="{Binding HasProfiles, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </Border>

                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" MaxHeight="360" Margin="0,8,0,0"
                                 AutomationProperties.Name="Saved profiles"
                                 Visibility="{Binding HasProfiles, Converter={x:Static views:Converters.BoolToVisibility}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusRing}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="12,9"
                                                        Margin="0,2" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg3}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg3}" />
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="#2E46C36B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MarkedStable, Converter={x:Static views:Converters.BoolToVisibility}}">
                                                    <TextBlock Text="Stable" FontSize="12" Foreground="{StaticResource Good}" />
                                                </Border>
                                                <Border Background="#2EE8B33C" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding FullyCertified, Converter={x:Static views:Converters.BoolToVisibility}}"
                                                        ToolTip="Passed all four stability modes (sustained, transitions, excursions, VRAM) at these settings, on this driver, with the current stress test.">
                                                    <TextBlock Text="Certified" FontSize="12" Foreground="{StaticResource Warn}" />
                                                </Border>
                                                <Border Background="#2E97A1AE" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding CertifiedWithOlderStressTest, Converter={x:Static views:Converters.BoolToVisibility}}"
                                                        ToolTip="Some of its stability passes were earned with an older stress test that could not detect a miscalculation, so they no longer count. Certify it again below.">
                                                    <TextBlock Text="Re-certify" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                <Run Text="core " /><Run Text="{Binding CoreOffsetMHz, Mode=OneWay}" /><Run Text=" MHz · mem " /><Run Text="{Binding MemOffsetMHz, Mode=OneWay}" /><Run Text=" MHz · power " /><Run Text="{Binding PowerLimitW, Mode=OneWay, StringFormat='{}{0:F0} W', TargetNullValue='unchanged'}" /><Run Text=" · fans " /><Run Text="{Binding FanMode, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ModifiedAt, Mode=OneWay, StringFormat=g}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource TextFaint}"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Apply" MinWidth="100" Margin="0,0,8,0"
                                        Command="{Binding ApplySelectedCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Load into Tuning" Margin="0,0,8,0"
                                        Command="{Binding LoadIntoTuningCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="Mark stable"
                                        Command="{Binding MarkStableCommand}"
                                        ToolTip="Confirms you've tested this profile under load (Stability page). Required before it may apply itself at startup." />
                            </WrapPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" FontSize="14" MinHeight="32"
                                    Command="{Binding DeleteSelectedCommand}" VerticalAlignment="Top"
                                    AutomationProperties.Name="Delete profile">
                                <TextBlock><Run Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" /><Run Text="  Delete" /></TextBlock>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Certification wizard -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Certify a profile" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Applies the selected profile and runs all four stability modes against it in turn: sustained burn, transition cycling, boost excursions and the full-VRAM test. Each pass is recorded in the profile, tied to its exact settings, its driver and the stress test that earned it; when any of those changes, the pass no longer counts. Passing all four marks it stable. A failure stops the run and resets the GPU to driver defaults." />

                        <ContentControl Style="{StaticResource WarnBanner}" Content="{Binding CertifyGateText}" Margin="0,12,0,0"
                                        Visibility="{Binding CanCertify, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />

                        <TextBlock Text="{Binding SelectedCertificationText}" Style="{StaticResource StatusText}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,12,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time per mode" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Style="{StaticResource TuneSlider}" Minimum="45" Maximum="300" Margin="12,0,20,0"
                                    Value="{Binding CertifySeconds}" TickFrequency="15" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Certification time per mode, seconds"
                                    IsEnabled="{Binding CertifyRunning, Converter={x:Static views:Converters.InverseBool}}" />
                            <TextBlock Grid.Column="2" Text="{Binding CertifySecondsLabel}" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" MinWidth="180" VerticalAlignment="Center"
                                    Command="{Binding ToggleCertifyCommand}" IsEnabled="{Binding CanCertify}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InheritingText}">
                                            <Setter Property="Text" Value="Certify selected profile" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CertifyRunning}" Value="True">
                                                    <Setter Property="Text" Value="Cancel certification" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding CertifyPhaseText}" Style="{StaticResource StatusText}"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding CertifyLog, Converter={x:Static views:Converters.NonEmptyToVisibility}}">
                            <ProgressBar Value="{Binding CertifyProgress, Mode=OneWay}" Maximum="1" />
                            <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                                <TextBlock Text="{Binding CertifyLog}" Style="{StaticResource LogText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Per-game rules -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Per-game profiles and driver settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="When the game starts, the profile selected above is applied; your previous tuning comes back when it exits. If two of these games run at once, the first one's profile stays; when it exits the other's takes over, and your tuning comes back after the last one closes. You can also set the NVIDIA driver's own per-game options (frame cap, vsync, low latency). Those are written to the same store the NVIDIA Control Panel edits, so they stay in effect even when Afterglow isn't running." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewRuleExe, UpdateSourceTrigger=PropertyChanged}"
                                     views:Hint.Placeholder="Game executable, e.g. cyberpunk2077.exe"
                                     AutomationProperties.Name="Game executable" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Add rule"
                                    Command="{Binding AddRuleCommand}" Margin="8,0,0,0"
                                    ToolTip="Adds a rule for this game. A game that already has a rule gets this one instead." />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="Frame cap" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding NewRuleCapFps, UpdateSourceTrigger=PropertyChanged}" Width="72"
                                     TextAlignment="Center" views:Hint.Placeholder="not set" Margin="0,0,20,0"
                                     AutomationProperties.Name="Frame cap, frames per second"
                                     ToolTip="The driver's frame-rate limiter for this game. Empty: Afterglow leaves the cap to the driver, so a global cap set in NVIDIA Control Panel still applies. 0 or off: no cap for this game, even with a global cap. 1–1000: a cap at that many fps." />
                            <TextBlock Text="Vsync" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding NewRuleVsyncIndex}" MinWidth="150" Margin="0,0,20,0"
                                      AutomationProperties.Name="Vsync">
                                <ComboBoxItem Content="Driver default" />
                                <ComboBoxItem Content="Force on" />
                                <ComboBoxItem Content="Force off" />
                            </ComboBox>
                            <CheckBox Content="Low latency (1 pre-rendered frame)" IsChecked="{Binding NewRuleLowLatency}"
                                      VerticalAlignment="Center" />
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding GameRules}" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg3}" CornerRadius="4" Padding="12,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" VerticalAlignment="Center">
                                                <Run Text="{Binding ExecutableName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  →  " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding ProfileName, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource SubtleButton}"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
